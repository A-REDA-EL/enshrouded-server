# Optional Compose overrides. Passwords are generated in server-data/*.json,
# never interpolated through Compose or passed as container environment values.
GAME_MEMORY_LIMIT=12g
# Coolify: use stable host paths prepared using the README's Coolify steps.
# ENSHROUDED_DATA_DIR=/opt/enshrouded/server-data
# ENSHROUDED_SCRIPTS_DIR=/opt/enshrouded/scripts
# After the first Coolify deployment, set its actual Compose project name here
# so host backup/update commands manage the same containers (see README).
# COMPOSE_PROJECT_NAME=your-coolify-compose-project
# Change only after reviewing an upstream release; pin its tag AND digest.
# ENSHROUDED_IMAGE=indifferentbroccoli/enshrouded-server-docker:<tag>@sha256:<digest>
